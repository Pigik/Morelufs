# Скопируйте в .env и заполните. .env не коммитится и не попадает в образ.
TELEGRAM_BOT_TOKEN=123456:ABC-токен-от-BotFather
ADMIN_CHAT_IDS=111111111,222222222
# Вход на сайт через Telegram (без них сайт работает, но заказы — только в мини-аппе).
# @BotFather → бот → Login Widget: Allowed URLs = https://morelufs.ru и https://morelufs.ru/auth/callback
TG_LOGIN_CLIENT_ID=
TG_LOGIN_CLIENT_SECRET=

# --- Оплата: ЮKassa (без этих двух ключей оформление заказов выключено, сайт и каталог работают) ---
# Личный кабинет yookassa.ru → «Интеграция» → «Ключи API»: shopId → YOOKASSA_SHOP_ID, секретный ключ → YOOKASSA_SECRET_KEY.
# Для проверок — тестовый магазин (свой shopId и ключ вида test_…), для продажи — боевой (ключ live_…).
# «Интеграция» → «HTTP-уведомления»: URL https://morelufs.ru/api/payment/notify,
# события payment.succeeded, payment.canceled, refund.succeeded.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС для чека через ЮKassa (1 — без НДС, 2 — 0%, 4 — 20% и т.д. по справочнику ЮKassa).
# Пусто — чек (receipt) не передаём: самозанятый пробивает чек сам в «Мой налог».
# Заполняйте, только если в ЮKassa подключены чеки по 54-ФЗ (онлайн-касса или «Чеки от ЮKassa»).
# YOOKASSA_VAT_CODE=

# --- Доставка СДЭК (пусто — способ «СДЭК» не показывается) ---
# Личный кабинет СДЭК (по договору) → Интеграция → «Ключи API»: Account → CLIENT_ID, Secure password → SECRET.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Боевой адрес по умолчанию; для проверок — тестовый https://api.edu.cdek.ru/v2 (и тестовые ключи из документации СДЭК)
# CDEK_API_URL=https://api.cdek.ru/v2
# Код города отправки по справочнику СДЭК (424 — Казань) и тариф (136 — «Посылка склад-склад»):
# CDEK_FROM_CITY_CODE=424
# CDEK_TARIFF=136
# Код ПВЗ СДЭК, куда вы сдаёте посылки (например, KZN123) — виден на карте ПВЗ на cdek.ru
CDEK_SHIPMENT_POINT=

# --- Доставка Почтой России (пусто — способ «Почта России» не показывается) ---
# otpravka.pochta.ru (нужен договор с Почтой) → Настройки → «Настройки API»: токен авторизации приложения.
POCHTA_TOKEN=
# Логин и пароль от личного кабинета otpravka.pochta.ru
POCHTA_LOGIN=
POCHTA_PASSWORD=
# Индекс отделения, где вы сдаёте посылки (указан в договоре / настройках «Места приёма»)
POCHTA_FROM_INDEX=

# Необязательные (значения по умолчанию):
# WEBAPP_URL=https://morelufs.ru/
# DB_PATH=/data/morelufs.db
# LOG_LEVEL=INFO
